# ==========================================
# SCRIPTURE & COMMENTARY CANVAS - ENVIRONMENT
# ==========================================

# GEMINI_API_KEY: Required for Live Gemini AI API calls.
#
# • VERCEL DEPLOYMENT:
#   In your Vercel Project Dashboard:
#   Go to Settings -> Environment Variables
#   Add GEMINI_API_KEY = your_google_gemini_api_key
#
# • GOOGLE AI STUDIO / CLOUD RUN:
#   Injected automatically or configured in Secrets panel.
#
# • LOCAL DEVELOPMENT:
#   Copy this file to .env and insert your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SYNTHESIS_ENGINE_MODE: (Optional)
# Options: 'simulated' (deterministic local heuristics, zero API calls)
#          'live' (invokes Gemini models via server-side proxy)
SYNTHESIS_ENGINE_MODE="live"

# ==========================================
# SUPABASE CLOUD SYNC (Production & Multi-Device Sync)
# ==========================================
# Obtain from your Supabase Dashboard -> Project Settings -> API
# Run supabase/schema.sql in the Supabase SQL Editor first.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ==========================================
# SIMULATION & QA TESTING (Client-Side & Dev Mode)
# ==========================================
# VITE_DEV_MODE: Set to 'false' to test production mode where Gemini API key is strictly required
# (Can also be tested without editing files via URL '?dev_mode=false' or console 'window.__TOGGLE_DEV_MODE(false)')
VITE_DEV_MODE="true"

# VITE_SIMULATE_SPLASH: Set to 'true' to hold and test the persistent PWA splash screen
VITE_SIMULATE_SPLASH="false"

# VITE_SIMULATE_LOGIN_SPLASH: Set to 'true' to hold and test the Log-In Splash modal
VITE_SIMULATE_LOGIN_SPLASH="false"

# VITE_SIMULATE_LOGGED_OUT: Set to 'true' to simulate logged-out / guest mode
VITE_SIMULATE_LOGGED_OUT="false"

# VITE_SIMULATE_OFFLINE: Set to 'true' to force offline mode & test active polling and offline toast
VITE_SIMULATE_OFFLINE="false"

# ==========================================
# RELEASE TAG & GITHUB VERSIONING (Production)
# ==========================================
# In local development, the app displays 'Dev' automatically.
# In production, set this to your GitHub release tag (e.g. 'v1.3.0'):
VITE_GITHUB_RELEASE_TAG="v1.3.0"
VITE_GITHUB_REPO="your-username/reneu"
